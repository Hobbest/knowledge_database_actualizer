[Unit]
Description=Knowledge Database Actualizer
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/knowledge-database-actualizer
EnvironmentFile=/etc/knowledge-database-actualizer.env
ExecStart=/opt/knowledge-database-actualizer/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
